@model IEnumerable<TutorBooking.Models.Subject>

@{
    ViewData["Title"] = "Subjects";
}

<div class="container mt-4">

    <div class="row mb-3">
        <div class="col-6">
            <h2>Subject List</h2>
        </div>

        <div class="col-6 text-end">
            <a asp-controller="Subject"
               asp-action="Create"
               class="btn btn-primary">
                Add New Subject
            </a>
        </div>
    </div>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success">
            @TempData["success"]
        </div>
    }

    <table class="table table-bordered table-striped">

        <thead>
            <tr>
                <th>
                    Subject Name
                </th>

                <th>
                    Description
                </th>

                <th>
                    Actions
                </th>
            </tr>
        </thead>

        <tbody>

            @foreach (var subject in Model)
            {
                <tr>

                    <td>
                        @subject.Name
                    </td>

                    <td>
                        @subject.Description
                    </td>

                    <td>

                        <a asp-controller="Subject"
                           asp-action="Edit"
                           asp-route-id="@subject.SubjectId"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a asp-controller="Subject"
                           asp-action="Delete"
                           asp-route-id="@subject.SubjectId"
                           class="btn btn-danger btn-sm">
                            Delete
                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>