@model TutorBooking.Models.Subject

@{
    ViewData["Title"] = "Edit Subject";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header">
            <h2>Edit Subject</h2>
        </div>

        <div class="card-body">

            <form method="post">

                <input asp-for="SubjectId" hidden />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>

                <div class="mb-3">

                    <label asp-for="Name"
                           class="form-label">
                    </label>

                    <input asp-for="Name"
                           class="form-control" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="Description"
                           class="form-label">
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Update
                </button>

                <a asp-controller="Subject"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Back
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}