@model TutorBooking.Models.Subject

@{
    ViewData["Title"] = "Delete Subject";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header">
            <h2>Delete Subject</h2>
        </div>

        <div class="card-body">

            <p>
                Are you sure you want to delete this subject?
            </p>

            <form method="post">

                <input asp-for="SubjectId" hidden />

                <div class="mb-3">

                    <label asp-for="Name"
                           class="form-label">
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           disabled />

                </div>

                <div class="mb-3">

                    <label asp-for="Description"
                           class="form-label">
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              disabled>
                    </textarea>

                </div>

                <button type="submit"
                        class="btn btn-danger">
                    Delete
                </button>

                <a asp-controller="Subject"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>