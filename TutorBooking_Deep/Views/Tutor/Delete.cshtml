@model TutorBooking.Models.Tutor

@{
    ViewData["Title"] = "Delete Tutor";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header">
            <h2>Delete Tutor</h2>
        </div>

        <div class="card-body">

            <p class="mb-4">
                Are you sure you want to delete this tutor?
            </p>

            <form method="post">

                <input asp-for="TutorId" type="hidden" />

                <div class="mb-3">

                    <label class="form-label">
                        Name
                    </label>

                    <input value="@Model.Name"
                           class="form-control"
                           disabled />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Email
                    </label>

                    <input value="@Model.Email"
                           class="form-control"
                           disabled />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Subject
                    </label>

                    <input value="@Model.Subject?.Name"
                           class="form-control"
                           disabled />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Availability
                    </label>

                    @if (Model.IsAvailable)
                    {
                        <div>
                            <span class="badge bg-success">
                                Available
                            </span>
                        </div>
                    }
                    else
                    {
                        <div>
                            <span class="badge bg-secondary">
                                Unavailable
                            </span>
                        </div>
                    }

                </div>

                <button type="submit"
                        class="btn btn-danger">
                    Delete Tutor
                </button>

                <a asp-controller="Tutor"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>