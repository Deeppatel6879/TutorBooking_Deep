@model TutorBooking.Models.Booking

@{
    ViewData["Title"] = "Delete Booking";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header">
            <h2>Delete Booking</h2>
        </div>

        <div class="card-body">

            <p>
                Are you sure you want to delete this booking?
            </p>

            <form method="post">

                <input asp-for="BookingId"
                       type="hidden" />

                <div class="mb-3">

                    <label class="form-label">
                        Student
                    </label>

                    <input value="@Model.StudentName"
                           class="form-control"
                           disabled />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Tutor
                    </label>

                    <input value="@Model.Tutor?.Name"
                           class="form-control"
                           disabled />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Date
                    </label>

                    <input value="@Model.BookingDate.ToString("dd/MM/yyyy")"
                           class="form-control"
                           disabled />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Time
                    </label>

                    <input value="@Model.BookingTime.ToString(@"hh\:mm")"
                           class="form-control"
                           disabled />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Status
                    </label>

                    <input value="@Model.Status"
                           class="form-control"
                           disabled />

                </div>

                <button type="submit"
                        class="btn btn-danger">
                    Delete Booking
                </button>

                <a asp-controller="Booking"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>